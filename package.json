    "@pinia/nuxt": "^0.5.1",
    "@vueuse/core": "^13.3.0",
    "apexcharts": "^5.14.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "dayjs-nuxt": "^2.1.11",
    "docx-preview": "^0.3.7",
    "iconify-icon": "^3.0.2",
    "lodash-es": "^4.18.1",
    "marked": "^17.0.6",
    "md-editor-v3": "^6.4.2",
    "nuxt": "^3.21.11",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.0",
    "types": "^0.1.1",
