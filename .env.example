# Example environment file
# Copy to .env and update values as needed

# API Base URL (without /api suffix)
NUXT_PUBLIC_API_BASE_URL=https://dev.unikorn.axfff.com

# Enable only after the independently deployed TeamUp route is healthy.
NUXT_PUBLIC_TEAMUP_ENABLED=false

# Forum mascot preview (shared development environment only)
NUXT_PUBLIC_MASCOT_ENABLED=true
NUXT_PUBLIC_MASCOT_MODEL_URL=/mascot/youyou/v1/youyou.model.json
NUXT_PUBLIC_MASCOT_SCALE=1.35
NUXT_PUBLIC_MASCOT_POSITION_X=0
NUXT_PUBLIC_MASCOT_POSITION_Y=-0.32

# In-site Agent chat. The provider API key stays in the backend environment.
NUXT_PUBLIC_AGENT_ENABLED=true
